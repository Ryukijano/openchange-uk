{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/hooks.py context"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/hooks.py deny",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/hooks.py check-sbatch"
      }
    ]
  }
}
